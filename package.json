{
  "name": "@tiwz/fontawesome",
  "version": "1.0.7",
  "description": "Download and self-host Font Awesome assets for Next.js, Vite, and React projects.",
  "type": "module",
  "license": "MIT",
  "author": "Phiraphan Tanan",
  "homepage": "https://github.com/TiwPhiraphan/fontawesome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiwPhiraphan/fontawesome.git"
  },
  "bugs": {
    "url": "https://github.com/TiwPhiraphan/fontawesome/issues"
  },
  "keywords": [
    "fontawesome",
    "font-awesome",
    "nextjs",
    "pro",
    "free",
    "vite",
    "react",
    "self-hosted",
    "icons",
    "webfonts"
  ],
  "bin": "./dist/bin/pull.js",
  "exports": {
    ".": {
      "import": "./dist/free.js",
      "types": "./dist/free.d.ts"
    },
    "./pro": {
      "import": "./dist/pro.js",
      "types": "./dist/pro.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.4.0",
    "@octokit/rest": "^22.0.1",
    "@types/react": "^19.2.14",
    "@types/bun": "1.3.14",
    "picocolors": "^1.1.1",
    "axios": "^1.16.0",
    "typescript": "^5",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "latest",
    "@fortawesome/free-regular-svg-icons": "latest",
    "@fortawesome/free-solid-svg-icons": "latest"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
